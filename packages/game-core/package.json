{
  "name": "@piatto/game-core",
  "version": "0.1.0",
  "private": true,
  "description": "Regole di Piatto condivise tra server, client e test",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
